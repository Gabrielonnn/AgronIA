VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Apply database changes with `supabase db push`; migrations are in supabase/migrations.
# Do not put a database password or service-role key in VITE_* variables.

# Configure the model credentials as Supabase Edge Function secrets, never here:
# AGRONIA_AI_API_URL=https://your-provider.example/v1/chat/completions
# AGRONIA_AI_API_KEY=server-side-secret
# AGRONIA_AI_MODEL=vision-model-name
VITE_PLANT_DIAGNOSIS_API_URL=http://localhost:8000/predict
